{
  "info": {
    "name": "API Testing Suite",
    "description": "Automated REST API test collection covering status codes, response structure, data validation and error handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": ["{{baseUrl}}"],
              "path": ["users"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Users contain required fields', function () {",
                  "    const users = pm.response.json();",
                  "    pm.expect(users.length).to.be.above(0);",
                  "    users.forEach(function (user) {",
                  "        pm.expect(user).to.have.property('id');",
                  "        pm.expect(user).to.have.property('name');",
                  "        pm.expect(user).to.have.property('email');",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/1",
              "host": ["{{baseUrl}}"],
              "path": ["users", "1"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Correct user is returned', function () {",
                  "    const user = pm.response.json();",
                  "    pm.expect(user.id).to.eql(1);",
                  "    pm.expect(user.email).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get nonexistent user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/999999",
              "host": ["{{baseUrl}}"],
              "path": ["users", "999999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Response body is empty object', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.eql({});",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Get posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Posts contain expected fields', function () {",
                  "    const posts = pm.response.json();",
                  "    pm.expect(posts).to.be.an('array');",
                  "    pm.expect(posts.length).to.be.above(0);",
                  "    pm.expect(posts[0]).to.have.property('userId');",
                  "    pm.expect(posts[0]).to.have.property('id');",
                  "    pm.expect(posts[0]).to.have.property('title');",
                  "    pm.expect(posts[0]).to.have.property('body');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA automation test\",\n  \"body\": \"Created by the API testing suite\",\n  \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Created post contains expected data', function () {",
                  "    const post = pm.response.json();",
                  "    pm.expect(post.title).to.eql('QA automation test');",
                  "    pm.expect(post.userId).to.eql(1);",
                  "    pm.expect(post).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
